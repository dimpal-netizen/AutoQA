# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/

# ---- Poetry ----
# poetry.lock IS committed on purpose (reproducible installs)

# ---- Testing / coverage ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- AutoQA runtime data ----
# Runtime output. Deliberately outside backend/ so uvicorn --reload does
# not restart the server every time a test run writes a .py file.
.autoqa/
backend/allure-results/
backend/*.log

# ---- Environment ----
# Every .env except the checked-in templates. The narrower ".env.*.local" that
# used to be here left ".env.production" tracked, so the file holding the
# database password, the signing key and the key that decrypts stored Jira
# credentials would have gone up with the first `git add -A`.
.env
.env.*
!.env.example
!.env.production.example

# ---- Node / Next.js (Phase 8) ----
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# ---- Chrome extension build (Phase 9) ----
extension/dist/
extension/*.zip

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Generated test scripts (opened in VS Code, not source)
# Your generated test scripts. Yours to open in VS Code, not ours to commit.
generated/
