"""Running the same recorded test more than once.

Generated by AutoQA.

A recording replays the data it captured. The second time it runs, the
application is often right to refuse it - the account exists now, the item is
taken, the slot is booked - and the run goes red against software that is
working. That failure is not a finding. It is the test asking for something it
already got.

This module is the part that notices, and the rules it works to are narrow on
purpose:

* **The recorded thing is always tried first.** A role marked on a step is
  permission to try something else *after* a refusal, never an instruction to
  start somewhere else. A test that reached for a different item before anything
  went wrong would no longer be replaying the journey it was given.

* **Only a refusal counts.** The application has to say, in its own words, that
  the data or the state is already the way the request wants it. Anything else -
  a page that simply did not do what it did during recording - is left to fail,
  because "it did not work and nobody said why" is what a defect looks like too.

* **Evidence of a defect stops everything.** A 5xx, a JavaScript exception, a
  stack trace on the page: these end the attempt immediately and let the test
  fail. Retrying through a broken application until something goes green is the
  one outcome worse than a red test.

* **Nothing is silent.** Every substitution is recorded and attached to the
  result, so a run that adapted says exactly what it changed. A green test
  nobody can interrogate is not evidence of anything.
"""

from __future__ import annotations

import os
import re
import time
from dataclasses import dataclass, field
from urllib.parse import urlparse

from pages._healing import every


class StateConflict(AssertionError):
    """The application refused, and nothing eligible was left to try.

    An AssertionError so pytest reports it as a failure rather than an error:
    the test did reach the application and the application did answer. What it
    said was no.
    """


#: What an application says when it will not do the same thing twice.
#:
#: Shared with the generator, which uses the identical pattern to decide which
#: steps are allowed to recover at all - so the half that grants permission and
#: the half that acts on it can never drift apart. See `dataroles.py`.
#:
#: A vocabulary of refusal, and of nothing else. "Invalid", "required" and "too
#: short" are all absent, and their absence is the point: those are the
#: application saying the data is wrong, which is a real finding. Trying
#: different data until something is accepted would bury it.
CONFLICT = re.compile({{ conflict_pattern | pystr }}, re.IGNORECASE)

#: How long a refusal is given to render before the step is taken as accepted.
#: Paid in full on every step that works, which is why it is not generous; a
#: message that is going to appear appears as soon as the answer comes back.
REFUSAL_MS = 1_200

#: How long the recorded navigation is given to happen.
#:
#: The same budget every other step in the suite gets, read from the same
#: variable conftest reads - and that is not tidiness, it is the whole
#: correctness of the thing. Set to ten seconds, this made a state-aware step
#: strictly less patient than the plain `wait_for_url` it replaced, on sites
#: whose conftest raised the timeout to sixty precisely because thirty was not
#: enough for them. The step then failed on a navigation that was simply still
#: arriving, and reported it as the application giving no reason.
#:
#: A wait that is not needed costs nothing: it returns the moment the page
#: arrives. The extra time is only ever spent on a step that was going to fail.
SETTLE_MS = int(os.environ.get("AUTOQA_ACTION_TIMEOUT_MS", 60_000))

#: How many members of a set are tried before giving up, and how many times a
#: form is resubmitted with new data. Bounded because "keep trying" is not a
#: test strategy: an application refusing twenty times has something to say and
#: the report should carry it rather than a tally of attempts.
MAX_MEMBERS = 8
MAX_SUBMISSIONS = 3


# ---------------------------------------------------------------------------
# Evidence that the application is broken, rather than merely unwilling
# ---------------------------------------------------------------------------
@dataclass
class _Evidence:
    """What went wrong on the page, as the browser saw it happen."""

    defects: list = field(default_factory=list)
    adaptations: list = field(default_factory=list)


_seen = _Evidence()


def watch(page, *, site: str = "") -> None:
    """Start collecting defect evidence from a page. Called by conftest.

    Two signals, both unambiguous and both invisible to a test that only reads
    the DOM. A 5xx is the server saying it failed; a JavaScript exception is the
    page saying the same thing. Both have to be knowable *before* the recovery
    gate opens - by the time a step has finished failing, the console has moved
    on.

    `site` is the application under test, and only its own failures are
    collected. A real page fetches from a dozen places nobody in this test has
    any opinion about - analytics, tag managers, fonts, chat widgets, ad
    exchanges - and those fail constantly. Counting them as evidence that the
    application is broken means the recovery gate is held shut by an advertising
    server having a bad afternoon.

    Empty `site` collects everything, which is what a test of this module wants
    and what a suite generated without a base URL falls back to.
    """
    page.on(
        "response",
        lambda response: (
            _seen.defects.append(f"HTTP {response.status} from {response.url[:200]}")
            if response.status >= 500 and _belongs_to(response.url, site)
            else None
        ),
    )
    page.on(
        "pageerror",
        lambda error: _seen.defects.append(f"JavaScript error: {str(error)[:200]}"),
    )


def _belongs_to(url: str, site: str) -> bool:
    """Is this request the application under test, rather than somebody else's?

    Compared on the registrable part of the host, so `api.example.com` counts
    for a suite recorded against `www.example.com` - an application's own back
    end is the application. Anything unparseable counts, because failing to read
    a URL is not a reason to discard evidence.
    """
    if not site:
        return True
    try:
        host = urlparse(url).netloc.split(":")[0].lower()
    except Exception:  # noqa: BLE001 - unreadable counts, see above
        return True
    return bool(host) and _registrable(host) == _registrable(site)


def _registrable(host: str) -> str:
    """The last two labels of a host: `www.example.com` -> `example.com`."""
    labels = host.lower().split(":")[0].strip(".").split(".")
    return ".".join(labels[-2:]) if len(labels) > 1 else host


def reset() -> None:
    """Forget everything from the previous test. Called by conftest."""
    _seen.defects.clear()
    _seen.adaptations.clear()


def adaptations() -> list:
    """What this test changed to get through. Read by conftest at teardown."""
    return list(_seen.adaptations)


#: A stack trace rendered into the page. Applications in debug mode put their
#: own failure on screen, and it must never be mistaken for a refusal.
_STACK_TRACE = re.compile(
    r"Traceback \(most recent call last\)"
    r"|\bat [\w.$]+\([^)]*:\d+:\d+\)"
    r"|Exception in thread"
    r"|\b(Fatal error|Uncaught \w*Error|Internal Server Error)\b"
    r"|\.(java|py|rb|php|cs|go):\d+\b",
    re.IGNORECASE,
)


def _defect_on_page(page) -> str | None:
    """An application failure written into the page itself."""
    try:
        body = page.locator("body").inner_text(timeout=1_000)
    except Exception:  # noqa: BLE001 - unreadable is not evidence of anything
        return None
    found = _STACK_TRACE.search(body or "")
    return f"the page is showing {found.group(0)[:80]!r}" if found else None


# ---------------------------------------------------------------------------
# Did the step work?
# ---------------------------------------------------------------------------
ACCEPTED, REFUSED, BROKEN = "accepted", "refused", "broken"


#: Stamped on refusals that were already on the page before a step, so only
#: what the step itself provoked is read afterwards.
SEEN = "data-autoqa-seen"


def _mark(page) -> tuple:
    """Where things stood before a step, so afterwards only changes are read.

    The refusals already on screen are stamped rather than counted, and that is
    not a refinement - counting is simply wrong here. An application that
    re-renders the same sentence leaves the count unchanged, so a step refused
    for the second time reads as accepted; and one that clears a message between
    steps leaves the count too high, so a real refusal reads as noise. Marking
    the elements asks the question that was actually meant: is this refusal one
    I have already seen?
    """
    try:
        _conflicts(page).evaluate_all(f"els => els.forEach(el => el.setAttribute({SEEN!r}, '1'))")
    except Exception:  # noqa: BLE001 - unstampable only costs a re-read
        pass
    return (len(_seen.defects),)


def _conflicts(page):
    return page.get_by_text(CONFLICT)


def _verdict(page, mark: tuple, navigates) -> tuple:
    """Accepted, refused, or broken - and why, in words a report can print.

    The order matters more than any single test in it. Evidence of a defect is
    read first and ends the matter, so an application that is failing cannot be
    retried into a pass by a test that noticed the refusal message first.

    Then the refusal, which is the only thing that ever justifies trying again.

    What is left over is the interesting case, and it is deliberately treated as
    a failure. A step that was recorded navigating somewhere, and now does not
    navigate and says nothing about why, is indistinguishable from a broken
    application - and between failing a working application and passing a broken
    one, only the first is recoverable. So the test fails, and a person reads the
    report.
    """
    (defects,) = mark

    if navigates is not None:
        try:
            page.wait_for_url(navigates, wait_until="domcontentloaded", timeout=SETTLE_MS)
            arrived = True
        except Exception:  # noqa: BLE001 - not arriving is an answer, not an error
            arrived = False
    else:
        arrived = False
        # Nothing to wait for, so wait for the refusal instead: if an unstamped
        # one appears the step was refused, and if none does within REFUSAL_MS
        # the application accepted it quietly, which is what acceptance looks
        # like on most forms.
        deadline = time.monotonic() + REFUSAL_MS / 1_000
        while time.monotonic() < deadline and not _refusal(page):
            try:
                page.wait_for_timeout(120)
            except Exception:  # noqa: BLE001 - page gone; the read below decides
                break

    # Defect evidence first, and it is worth being clear why, because the
    # opposite order is tempting and wrong.
    #
    # A step whose click navigated exactly as recorded, onto a page the server
    # answered 503 for, *has* technically done what it was recorded doing. Let
    # it pass and the run reports "could not find the email field" two steps
    # later, against an error page - a true sentence about the wrong thing. Stop
    # here and it reports "HTTP 503 from https://…/login", which is the whole
    # problem in one line.
    #
    # What made this over-report was never the order. It was the scope: any
    # host counted, so an analytics beacon having a bad afternoon failed a
    # working checkout. `watch` now collects only the application's own
    # failures, which is the fix - see `_belongs_to`.
    if len(_seen.defects) > defects:
        return BROKEN, _seen.defects[defects]

    on_page = _defect_on_page(page)
    if on_page:
        return BROKEN, on_page

    said = _refusal(page)
    if said:
        return REFUSED, said

    if navigates is None or arrived:
        return ACCEPTED, ""

    return BROKEN, (
        f"it did not reach {navigates.pattern!r} within {SETTLE_MS}ms, as it did "
        "when it was recorded, and the application gave no reason - which is "
        "what a defect looks like, so nothing was retried"
    )


def _refusal(page) -> str:
    """The refusal that appeared because of this step, if one did.

    Only what is new. An application that carries "already registered" in a
    sidebar would otherwise refuse every step on the page, and a test that
    believes it has been refused when it has not is a test that quietly stops
    testing anything.

    One thing this cannot see, and it is worth being clear about: an application
    that writes the identical sentence into the identical element it used last
    time has changed nothing observable, and the step reads as accepted. Every
    application seen so far either re-renders the message or names the thing it
    is refusing, both of which are caught.
    """
    try:
        # `and_` intersects on the element itself, which is where the stamp is.
        # `filter(has_not=...)` would ask about its descendants instead and
        # report every refusal as new.
        texts = (
            _conflicts(page)
            .and_(page.locator(f"css=:not([{SEEN}])"))
            .all_inner_texts()
        )
    except Exception:  # noqa: BLE001 - mid-navigation; nothing new counted
        return ""

    for text in texts:
        cleaned = " ".join(str(text).split())
        if cleaned:
            return cleaned[:200]
    return ""


# ---------------------------------------------------------------------------
# The two things a test is allowed to vary
# ---------------------------------------------------------------------------
#: Stamped on every element this has already clicked, so an alternative that is
#: really the recorded element wearing a different selector is not tried twice.
TRIED = "data-autoqa-tried"


def one_of(page_object, name: str, *, step: int, described: str,
           among: str | None = None, navigates=None) -> None:
    """Act on the recorded element; try a member beside it only if refused.

    STATE_DEPENDENT: the recorded element was one of several of the same shape -
    a row, a card, a tile, a slot - and which one the workflow runs on is not
    what the test is about. Whether the workflow runs is.

    Read the order carefully, because it is the whole safety argument. The
    element the recording used goes first, always, located exactly as it always
    was. Only once the application has refused it *in its own words* does
    `among` come into play - the wider locator matching everything of that
    shape - and each member is tried in turn until one is accepted.

    When the set runs out the test fails, carrying what the application said.
    An application that refuses every member of a set is telling you something,
    and a green test would hide it.

    `among` is None whenever the recording gave no way of finding the elements
    beside this one. Then this is a plain click that reports a refusal properly,
    which is still better than one that reports it as a timeout.
    """
    page = page_of(page_object)
    origin = page.url
    refusals = []

    recorded = getattr(page_object, name)
    _stamp(recorded)
    mark = _mark(page)

    try:
        recorded.click()
    except Exception as unreachable:  # noqa: BLE001 - see `_vanished`
        verdict, because = _vanished(page, page_object, among, unreachable)
        if verdict is not REFUSED:
            raise
    else:
        verdict, because = _verdict(page, mark, navigates)

    if verdict is ACCEPTED:
        return
    _stop_if_broken(verdict, because, step, described)
    refusals.append(because)

    if among is None:
        raise StateConflict(
            f"Step {step} ({described}): the application refused it - {because} - "
            "and the recording holds no way of finding anything comparable to try "
            "instead."
        )

    for attempt in range(MAX_MEMBERS):
        if page.url != origin:
            page.goto(origin, wait_until="domcontentloaded")

        member = _untried(page_object, among)
        if member is None:
            break

        _stamp(member)
        mark = _mark(page)
        try:
            member.click()
        except Exception:  # noqa: BLE001 - one that will not open is one to skip
            continue
        verdict, because = _verdict(page, mark, navigates)

        if verdict is ACCEPTED:
            adapted(
                step,
                described,
                f"used a comparable element instead, after {len(refusals)} "
                "refusal(s) of the recorded one",
                refusals[0],
            )
            return

        _stop_if_broken(verdict, because, step, described)
        refusals.append(because)

    raise StateConflict(
        f"Step {step} ({described}): the application refused the recorded element "
        f"and every comparable one tried ({len(refusals)} in total). "
        f"Last refusal: {refusals[-1] or 'none given'}"
    )


def _vanished(page, page_object, among, unreachable) -> tuple:
    """The recorded element could not be clicked. Is that state, or a defect?

    The case that started all of this, and the one a refusal message cannot
    cover. Some applications say "you already have this"; a great many simply
    stop offering it. The Add to Cart on the item you bought last run is not
    disabled and not greyed out - it is a Remove button now, and the recorded
    locator matches nothing at all. The click waits its full sixty seconds and
    raises, and no amount of reading the page afterwards will find a sentence
    explaining why, because none was ever written.

    So the question is asked a different way: **is the page still offering
    others of this kind?** If comparable elements are there and usable, the page
    rendered perfectly well and exactly one thing is missing - which is what
    consuming an item looks like, and is worth trying a neighbour for. If
    nothing comparable is there either, then the page did not render its
    controls, and that is a real failure that must reach the report unchanged.

    Defect evidence overrides both - and here it is *any* evidence seen during
    the test, not merely what this step provoked. Everywhere else the delta is
    the right question, because the step is being judged on what it did. This is
    judging something else: whether an element's absence is benign. A page that
    has thrown a 500 at any point cannot support that conclusion, since the
    element may well be missing *because* of it.

    The caller re-raises the original error whenever this does not return
    REFUSED, so a step with nothing to fall back on fails exactly as it did
    before any of this existed - with Playwright's own message, naming the
    locator it waited for.
    """
    if _seen.defects:
        return BROKEN, _seen.defects[-1]

    on_page = _defect_on_page(page)
    if on_page:
        return BROKEN, on_page

    if among is None or _untried(page_object, among) is None:
        return BROKEN, str(unreachable)[:200]

    return REFUSED, (
        "the recorded element is no longer on the page, though comparable ones "
        "are - which is what an item that has been used up looks like"
    )


def _stop_if_broken(verdict, because: str, step: int, described: str) -> None:
    """Nothing is retried through a broken application.

    The single most important line in this file. A test that keeps trying until
    something goes green turns a 5xx into a pass, and a suite that does that is
    worse than no suite: it reports health it did not measure.
    """
    if verdict is BROKEN:
        raise StateConflict(
            f"Step {step} ({described}) failed and was NOT retried: {because}. "
            "That is not a data or state conflict, so the recorded step stands "
            "and this is a real failure."
        )


#: A marker is worth a moment, never a minute. Left at the page default this
#: spent the whole sixty-second action budget discovering an element was gone,
#: and then the click spent it again saying so properly - two minutes to report
#: one missing button.
STAMP_MS = 1_000


def _stamp(locator) -> None:
    """Mark an element as tried, so it is not offered again as an alternative."""
    try:
        locator.first.evaluate(f"el => el.setAttribute({TRIED!r}, '1')", timeout=STAMP_MS)
    except Exception:  # noqa: BLE001 - unmarkable only costs a repeated attempt
        pass


def _untried(page_object, among: str):
    """A member of the set that has not been clicked yet, and can be clicked."""
    members = every(page_object, among)
    try:
        total = min(members.count(), MAX_MEMBERS)
    except Exception:  # noqa: BLE001 - nothing to choose from
        return None

    for index in range(total):
        member = members.nth(index)
        try:
            if member.get_attribute(TRIED):
                continue
            if member.is_visible() and member.is_enabled():
                return member
        except Exception:  # noqa: BLE001 - gone between the count and the question
            continue
    return None


def submit(
    page_object, name: str, *, step: int, described: str, renew=(), navigates=None
) -> None:
    """Send a form, and send it again with new data if it is refused as duplicate.

    UNIQUE: the recording created a record, and the identifiers in it belong to
    that record now. The generator already replaces those with fresh values on
    every run - see `unique_values` in the test - so this is the second line of
    defence, for when a generated value collides anyway or when the application
    keeps something unique that nothing could have predicted.

    `renew` is [(make_value, [(page_object, locator_name), ...]), ...]. The
    fields are grouped by the value they share, because an address and its
    confirmation have to keep matching, and two calls to the generator would put
    two different addresses in fields the form requires to be the same.
    """
    for attempt in range(MAX_SUBMISSIONS):
        page = page_of(page_object)
        mark = _mark(page)
        every(page_object, name).first.click()
        verdict, because = _verdict(page, mark, navigates)

        if verdict is ACCEPTED:
            return

        _stop_if_broken(verdict, because, step, described)

        if attempt == MAX_SUBMISSIONS - 1 or not renew:
            break

        for make_value, fields in renew:
            value = make_value()
            for holder, locator_name in fields:
                getattr(holder, locator_name).fill(value)
            adapted(
                step,
                described,
                f"entered a new value in {', '.join(f for _, f in fields)} and "
                "submitted again",
                because,
            )

    raise StateConflict(
        f"Step {step} ({described}): the application refused the submission "
        f"{MAX_SUBMISSIONS} time(s), most recently with {because!r}."
    )


def page_of(page_object):
    """The Playwright page a generated page object is driving."""
    return page_object.page


def adapted(step: int, described: str, what: str, because: str) -> None:
    """Write down that the test did something other than what was recorded.

    The whole design rests on this being complete. A run that recovered is not a
    normal pass and must never read like one: somebody has to be able to see
    that step 11 took a different item, and why, without knowing to go looking.
    """
    note = f"step {step} ({described}): {what}"
    if because:
        note += f" - the application said: {because}"
    _seen.adaptations.append(note)
    print(f"[autoqa] ADAPTED {note}")
