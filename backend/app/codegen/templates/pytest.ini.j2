[pytest]
# Generated by AutoQA.
# Run:  pytest --browser chromium --browser firefox --browser webkit
testpaths = tests
python_files = test_*.py
addopts =
    -v
    --strict-markers
    --tracing=retain-on-failure
    --screenshot=only-on-failure
    --video=retain-on-failure
    --output=artifacts
markers =
    smoke: the fastest check that the app is alive
    recorded: generated from a recorded session
