"""Finding an element when the first way of finding it has stopped working.

Generated by AutoQA.

Every element was recorded several ways over: by role and name, by label, by
text, by a path through the page. Only the best one is used, and until now the
rest were a comment - so a renamed class broke a test that had three working
alternatives written directly above it.

`heal` tries them in order and takes the first that finds the element. It never
invents a way of looking; every candidate came from the recording of that exact
element.

When it has to fall back it says so. A test that quietly adapts to a changed
page is worse than one that fails: the page really did change, and you would
never hear about it.

Healing applies to *driving* the page, never to *observing* it. `unhealed`
below is how an assertion opts out, and why it has to.
"""

import warnings

from playwright.sync_api import Locator

# The first candidate is the one that should work, so it gets a real wait -
# long enough that a slow page is not mistaken for a broken selector, which
# would heal to a different element and make things worse rather than better.
PRIMARY_TIMEOUT_MS = 10_000

# By the time a spare is tried the element has already failed to appear once,
# so the page is loaded and the answer is immediate either way.
SPARE_TIMEOUT_MS = 2_000

#: Cleared while `unhealed` reads a property. Not thread-safe, and does not
#: need to be: a Playwright sync page is driven by one thread, and pytest-xdist
#: parallelises across processes.
_substitutes_allowed = True


class Healed(UserWarning):
    """The page changed and a recorded alternative was used instead."""


def unhealed(page_object: object, name: str) -> Locator:
    """The element as it was recorded, with the spares switched off.

    Healing is right when the test is *doing* something. If the login button was
    renamed, finding it by its position instead and clicking it is exactly what
    should happen - the test is about what the click leads to, not about how the
    button was found.

    An assertion is the opposite. It asks a question about one element, and a
    spare answers it about a different one:

        expect(otp_modal).to_be_hidden()

    That modal's recorded selector carries `isOpen` in its class, so with the
    modal closed it correctly matches nothing - which is the answer the test was
    looking for. Healing then tried the positional spare,
    `//body/main[1]/div[1]/.../svg[1]`, matched whatever sits at that path on
    the registration page, and the assertion failed on an element that was never
    the OTP modal. Six generated tests reported red against a form that had
    rejected the duplicate email exactly as it should.

    The mirror case is worse for being quiet: `to_be_visible()` on an element
    that has genuinely gone passes the moment a positional spare finds anything
    at all in its place.
    """
    global _substitutes_allowed
    _substitutes_allowed = False
    try:
        return getattr(page_object, name)
    finally:
        _substitutes_allowed = True


#: A hover that opens a menu opens it at once or not at all. Waiting the full
#: thirty seconds only delays a failure the next step will describe better.
REVEAL_TIMEOUT_MS = 2_000


def reveal(target: Locator) -> None:
    """Hover something whose only job is to open a menu.

    Failures are swallowed on purpose, and that is not the usual "ignore the
    error" - it is where the error belongs.

    A hover asserts nothing. It exists so the next step can reach an item that
    is hidden until the pointer arrives. If the hover works, the next step is
    the one with something to say. If it does not, the next step still is:

        Locator.click: Timeout 30000ms exceeded
          - locator resolved to <a href="...property-type=HOUSE">House</a>
          - element is not visible

    which names the menu item nobody could reach. Letting the hover raise
    instead reports "could not hover the navigation link", which is a fact about
    the mouse rather than about the application.

    It also removes a whole class of false failure. One suite hovered a button
    whose label was mid-flight - "Creating Account..." - and whether that step
    passed came down to how fast the server answered. Sometimes the text had
    already changed; sometimes a modal had opened over it and taken the pointer.
    Thirty seconds later the run was red, with nothing wrong anywhere.
    """
    try:
        target.hover(timeout=REVEAL_TIMEOUT_MS)
    except Exception:  # noqa: BLE001 - any failure here is the next step's news
        pass


def set_checked(box: Locator, checked: bool) -> None:
    """Tick or untick a checkbox the way a person does.

    Almost every modern site hides the real `<input type="checkbox">` and draws
    a styled box on top of it, so the control the test found is `0x0` pixels:

        <input type="checkbox"/>   box: {width: 0.0, height: 0.0}

    Playwright refuses to act on an element nobody can see, and quite rightly -
    but it waits the full timeout first, so a filter that works perfectly in the
    browser fails like this:

        Locator.check: Timeout 30000ms exceeded.
          - locator resolved to <input type="checkbox"/>
          - element is not visible

    Thirty seconds, then red, on a feature with nothing wrong with it.

    Clicking the associated `<label>` is what the person did when they recorded
    it, and the browser forwards that to the input. So: read the state off the
    input - which needs no visibility, it is a property not a gesture - and if it
    already matches, do nothing. That is what makes this safe to call twice.

    `force=True` is deliberately not used. It would skip the visibility check and
    click at the input's coordinates, which happen to land on the styled box, and
    that works right up until the site moves one a few pixels from the other.
    """
    if box.is_checked() == checked:
        return

    if box.is_visible():
        box.check() if checked else box.uncheck()
        return

    label = box.locator("xpath=ancestor::label[1]")
    if not label.count():
        box_id = box.get_attribute("id")
        label = box.page.locator(f"label[for={box_id!r}]") if box_id else label

    if not label.count():
        # No label to click. Let Playwright raise its own error against the
        # input, which names the element and says it is not visible - a truer
        # report than anything invented here.
        box.check() if checked else box.uncheck()
        return

    label.first.click()


def heal(name: str, candidates: list) -> Locator:
    """The first candidate that finds the element.

    `candidates` is [(strategy, () -> Locator), ...], best first. The callables
    are not evaluated until they are needed, so the common case - the first one
    works - costs exactly one lookup.
    """
    if not _substitutes_allowed:
        # Reached through `unhealed`. No spares, and no wait either: the
        # `expect` around this does its own waiting and retrying, and waiting
        # here for an element the test expects to be *gone* would spend
        # PRIMARY_TIMEOUT_MS on every run to learn what it already knew.
        return candidates[0][1]()

    for index, (strategy, find) in enumerate(candidates):
        locator = find()
        try:
            locator.first.wait_for(
                state="attached",
                timeout=PRIMARY_TIMEOUT_MS if index == 0 else SPARE_TIMEOUT_MS,
            )
        except Exception:
            continue

        if index:
            warnings.warn(
                f"{name}: could not be found by {candidates[0][0]} - used "
                f"{strategy} instead. The page has changed.",
                Healed,
                stacklevel=2,
            )
        return locator

    # Nothing matched. Return the primary rather than raising here, so the
    # failure comes from the action the test was actually performing and names
    # the selector you would expect to see.
    return candidates[0][1]()
