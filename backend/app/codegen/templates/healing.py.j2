"""Finding an element when the first way of finding it has stopped working.

Generated by AutoQA.

Every element was recorded several ways over: by role and name, by label, by
text, by a path through the page. Only the best one is used, and until now the
rest were a comment - so a renamed class broke a test that had three working
alternatives written directly above it.

`heal` tries them in order and takes the first that finds the element. It never
invents a way of looking; every candidate came from the recording of that exact
element.

When it has to fall back it says so. A test that quietly adapts to a changed
page is worse than one that fails: the page really did change, and you would
never hear about it.
"""

import warnings

from playwright.sync_api import Locator

# The first candidate is the one that should work, so it gets a real wait -
# long enough that a slow page is not mistaken for a broken selector, which
# would heal to a different element and make things worse rather than better.
PRIMARY_TIMEOUT_MS = 10_000

# By the time a spare is tried the element has already failed to appear once,
# so the page is loaded and the answer is immediate either way.
SPARE_TIMEOUT_MS = 2_000


class Healed(UserWarning):
    """The page changed and a recorded alternative was used instead."""


def heal(name: str, candidates: list) -> Locator:
    """The first candidate that finds the element.

    `candidates` is [(strategy, () -> Locator), ...], best first. The callables
    are not evaluated until they are needed, so the common case - the first one
    works - costs exactly one lookup.
    """
    for index, (strategy, find) in enumerate(candidates):
        locator = find()
        try:
            locator.first.wait_for(
                state="attached",
                timeout=PRIMARY_TIMEOUT_MS if index == 0 else SPARE_TIMEOUT_MS,
            )
        except Exception:
            continue

        if index:
            warnings.warn(
                f"{name}: could not be found by {candidates[0][0]} - used "
                f"{strategy} instead. The page has changed.",
                Healed,
                stacklevel=2,
            )
        return locator

    # Nothing matched. Return the primary rather than raising here, so the
    # failure comes from the action the test was actually performing and names
    # the selector you would expect to see.
    return candidates[0][1]()
