#: The smallest thing a server will accept as a PDF: a catalogue, a page tree,
#: one empty A4 page. Enough for an upload field, not enough to read.
#: The smallest thing a server will accept as a PDF: a catalogue, a page tree,
#: one empty A4 page. Enough for an upload field, not enough to read.
_NEWLINE = bytes([10])

_PDF = _NEWLINE.join([
    b"%PDF-1.4",
    b"1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj",
    b"2 0 obj<</Type/Pages/Kids[3 0 R]/Count 1>>endobj",
    b"3 0 obj<</Type/Page/Parent 2 0 R/MediaBox[0 0 595 842]>>endobj",
    b"trailer<</Root 1 0 R>>",
    b"%%EOF",
    b"",
])

_TEXT = b"AutoQA sample file" + _NEWLINE


def _png(width: int = WIDTH, height: int = HEIGHT) -> bytes:
    """A PNG of the given size, built rather than stored.

    Four chunks: the signature, IHDR describing the image, IDAT holding the
    pixels, IEND closing it. Every scanline carries a leading filter byte of 0,
    meaning "stored as-is", and the whole lot is deflated - which is why a flat
    colour costs about a kilobyte whatever the dimensions.
    """
    row = bytes([0]) + bytes((216, 222, 233)) * width   # filter byte, then RGB
    pixels = zlib.compress(row * height, 9)

    def chunk(kind, payload):
        body = kind + payload
        return struct.pack(">I", len(payload)) + body + struct.pack(">I", zlib.crc32(body))

    return (
        bytes([137, 80, 78, 71, 13, 10, 26, 10])
        + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
        + chunk(b"IDAT", pixels)
        + chunk(b"IEND", b"")
    )


def _from_the_library(suffix: str) -> dict | None:
    """The next real file of that kind the project uploaded, or None.

    Round-robin rather than always the first, so a form asking for six
    photographs gets six different ones. A listing whose gallery is the same
    picture six times is not what anybody meant by uploading a library.

    Matched on the kind of file, because a form that takes images will not take
    the PDF sitting next to them.
    """
    if not SAMPLES.is_dir():
        return None

    kind = MIME_TYPES.get(suffix)
    matches = sorted(
        path
        for path in SAMPLES.iterdir()
        if path.is_file() and MIME_TYPES.get(path.suffix.lower()) == kind
    ) if kind else []

    # Nothing of that kind. An image asked for where only PDFs were uploaded
    # falls through to the placeholder rather than uploading the wrong thing.
    if not matches:
        return None

    path = matches[next(_TURN) % len(matches)]
    return {
        "name": path.name,
        "mimeType": MIME_TYPES[path.suffix.lower()],
        "buffer": path.read_bytes(),
    }


#: One counter for the whole run, so consecutive uploads move through the
#: library rather than each starting at the front of it.
_TURN = itertools.count()

MIME_TYPES = {
    ".jpg": "image/jpeg",
    ".jpeg": "image/jpeg",
    ".png": "image/png",
    ".gif": "image/gif",
    ".webp": "image/webp",
    ".pdf": "application/pdf",
    ".txt": "text/plain",
    ".csv": "text/csv",
}


def sample_file(name: str) -> dict:
    """The file to upload in place of the one that was picked by hand.

    Returns what `set_input_files` wants: a name, a MIME type and the bytes.

    The three always agree. A site may check the extension, the type the browser
    reports, or the first few bytes of the file itself - all three say the same
    thing here, so a rejection means something about the site rather than about
    the fixture.
    """
    stem, dot, extension = name.rpartition(".")
    suffix = f".{extension.lower()}" if dot else ""

    # A real one if the project has uploaded any of that kind. A placeholder
    # uploads fine and gets past the form, but it is a grey rectangle - a site
    # that shows the photograph back on the listing deserves a photograph, and
    # a test that checks the gallery cannot be written against a rectangle.
    real = _from_the_library(suffix or ".png")
    if real is not None:
        return real

    if suffix in (".jpg", ".jpeg"):
        return {"name": name, "mimeType": "image/jpeg",
                "buffer": base64.b64decode(_JPEG_BASE64)}
    if suffix == ".png":
        return {"name": name, "mimeType": "image/png", "buffer": _png()}
    if suffix == ".pdf":
        return {"name": name, "mimeType": "application/pdf", "buffer": _PDF}
    if suffix in (".txt", ".csv", ".json"):
        mime = {".txt": "text/plain", ".csv": "text/csv",
                ".json": "application/json"}[suffix]
        return {"name": name, "mimeType": mime, "buffer": _TEXT}

    # Something we cannot produce - .gif, .webp, .heic. A PNG under a changed
    # name is honest about what is being sent. PNG bytes wearing a .gif
    # extension would be turned away by anything that looks inside the file,
    # and that failure would read as a bug in the upload.
    return {"name": f"{stem or name}.png", "mimeType": "image/png", "buffer": _png()}
