# Assertions get their own timeout, and it is deliberately not Playwright's
# default of five seconds.
#
# An action waits thirty seconds for its element. An assertion waited five. So a
# click that really did navigate, on an app that took longer than five seconds
# to render the next page, failed like this:
#
#     AssertionError: Page URL expected to be '/find-agent'
#     Actual value: https://.../properties
#       13 x unexpected value "https://.../properties"
#
# Nothing was wrong. Driven by hand afterwards, that same click reached
# /find-agent every time - in about two and a half seconds on an idle machine,
# and the suite runs three browsers at once. The test was impatient, and it
# reported a broken link.
#
# Waiting longer costs nothing when the assertion passes: `expect` polls and
# returns the moment the condition holds. The extra time is only ever spent on a
# genuine failure, which is precisely when being sure is worth it.
EXPECT_TIMEOUT_MS = int(os.environ.get("AUTOQA_EXPECT_TIMEOUT_MS", 10_000))
expect.set_options(timeout=EXPECT_TIMEOUT_MS)

# How long one action waits for its element, and how long a navigation started
# by one is given to arrive. Playwright's own default is thirty seconds, and a
# recorded journey against a real application outgrows it:
#
#     TimeoutError: Timeout 30000ms exceeded.
#     waiting for navigation to ".../property-owner/add-property"
#
# The click had worked. The site loads a map widget and a pile of advertising
# and analytics, the suite runs three browsers at once on one machine, and the
# page a person waited a moment for during recording takes longer than that when
# something else is competing for the CPU.
#
# Recording is unhurried in a way that replay is not - somebody stops to read
# the form, and the application has finished settling long before they click
# again. A replay clicks the instant the previous step returns.
#
# Waiting longer costs nothing when the step succeeds: every wait here returns
# the moment its condition holds. The extra time is only ever spent on a step
# that was going to fail, which is exactly when being sure it really failed is
# worth the wait.
ACTION_TIMEOUT_MS = int(os.environ.get("AUTOQA_ACTION_TIMEOUT_MS", 60_000))

