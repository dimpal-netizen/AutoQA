"""Waiting for what an action actually does.

Generated by AutoQA.

A test has to know when a step has finished before it starts the next one, and
there are only two honest ways to know. Watch for the thing the action was seen
to do when it was recorded, or watch the page until it stops changing. This
module does both, and nothing else - in particular it never sleeps, because a
sleep is a guess that is too long on a fast machine and too short on a slow one,
and wrong in a different direction on every run.

What to wait for is not decided here. It was decided when the recording was
made, by watching: the recorder notes whether the click navigated, opened a
dialog, put a message on the screen, changed the DOM, or did nothing visible at
all, and the generator turns that observation into one call below. Which is the
whole point - the same six strategies serve a shop, an admin console, a booking
system and a bank, because none of them is about what the application *is*.

The strategy is a floor and never a ceiling. Every wait here returns the moment
its condition holds, and every Playwright action does its own waiting for its
own element afterwards. So a strategy that turns out to be wrong costs a little
time and not a failure - which is why `quiet` is safe to emit, and why nothing
here raises on a timeout.
"""

from __future__ import annotations

import os

#: How long any single outcome is given to appear. The same budget the rest of
#: the suite uses, from the same variable, because a step that has to wait for a
#: dialog is not less patient than one that has to wait for a button.
SETTLE_MS = int(os.environ.get("AUTOQA_ACTION_TIMEOUT_MS", 60_000))

#: How long a DOM that is still changing is followed before giving up on it
#: settling. Deliberately much shorter than the budget above: an application
#: that mutates continuously - a carousel, a clock, a live feed - never settles,
#: and waiting the full minute for it on every step would be the slowest
#: possible way to learn nothing.
QUIET_BUDGET_MS = 5_000

#: Two polls at the same mutation count is "stopped". The page only has to be
#: still for a moment; the action that follows waits for its own element.
QUIET_MS = 250
POLL_MS = 50


def after(page, kind: str, *, url=None, text: str = "") -> None:
    """Wait for what this action was observed to do when it was recorded.

    `kind` is one of the outcomes the recorder can tell apart. Anything
    unrecognised - a newer recorder, a hand-edited test - falls through to
    watching the DOM settle, which is the answer that is never wrong, only
    sometimes slower than a better one would have been.

    Never raises. A step whose outcome did not arrive is not failed here: the
    next action fails on its own element with a message naming what it wanted,
    which is a far better report than "the previous step did not settle". The
    exception is a step that is *checking* something, and those are assertions,
    which do their own waiting and their own failing.
    """
    if kind == "navigated":
        _navigated(page, url)
    elif kind in ("dialog_opened", "dialog_closed"):
        _dialog(page, opening=kind == "dialog_opened")
    elif kind == "messages" and text:
        _text(page, text)
    elif kind == "quiet":
        return                      # nothing moved when this was recorded
    else:
        _settled(page)              # dom_changed, and anything unrecognised


def _navigated(page, url) -> None:
    """The address the recording arrived at, or any address but this one.

    `url` is None when the recording saw a navigation but the generator could
    not pin down where to - an SPA route that leaves no address behind, a
    redirect chain. Waiting for "not where we started" is weaker but still an
    observation rather than a guess.
    """
    where = page.url
    try:
        if url is not None:
            page.wait_for_url(url, wait_until="domcontentloaded", timeout=SETTLE_MS)
        else:
            page.wait_for_url(lambda current: current != where, timeout=SETTLE_MS)
    except Exception:  # noqa: BLE001 - the next step reports this far better
        pass


def _dialog(page, *, opening: bool) -> None:
    """A dialog by declaration, never by appearance.

    `role="dialog"`, `role="alertdialog"`, and the `<dialog>` element itself.
    A class called `modal` is on half the pages on the internet whether
    anything is open or not, and waiting on one would wait on a page's
    stylesheet rather than on its behaviour.
    """
    dialog = page.locator("dialog[open],[role=dialog],[role=alertdialog]")
    try:
        if opening:
            dialog.first.wait_for(state="visible", timeout=SETTLE_MS)
        else:
            dialog.first.wait_for(state="hidden", timeout=SETTLE_MS)
    except Exception:  # noqa: BLE001 - see `after`
        pass


def _text(page, text: str) -> None:
    """The sentence the application put on screen when this was recorded.

    The most specific wait there is, and the only one that says anything about
    *this* application - which is why it is only ever used with a sentence the
    recording actually saw, never one invented here.
    """
    try:
        page.get_by_text(text, exact=False).first.wait_for(
            state="attached", timeout=SETTLE_MS
        )
    except Exception:  # noqa: BLE001 - see `after`
        pass


def _settled(page) -> None:
    """The DOM has stopped changing.

    The general answer, for every action that did something the recorder could
    see but could not name - a list re-rendered, a panel swapped, a total
    recalculated after an API call came back. It is exactly the question worth
    asking about those: not *which* request finished, which is a fact about an
    implementation, but whether the page has finished reacting.

    Waiting on network idle instead was the obvious alternative and it is worse
    on the modern web: a page holding a websocket, polling for notifications, or
    streaming analytics is never idle, and a wait for it is a wait for the full
    timeout on every single step.

    Counted in the page rather than compared as strings, because reading the
    whole DOM out to compare it costs more than the wait it is timing.
    """
    try:
        page.wait_for_function(
            """(quietMs) => {
                const now = Date.now();
                if (!window.__autoqa_settle) {
                    window.__autoqa_settle = { seen: 0, since: now, observer: null };
                    const state = window.__autoqa_settle;
                    state.observer = new MutationObserver((records) => {
                        state.seen += records.length;
                        state.since = Date.now();
                    });
                    state.observer.observe(document.documentElement, {
                        childList: true, subtree: true,
                        attributes: true, characterData: true,
                    });
                    return false;      // give it one interval to see something
                }
                return now - window.__autoqa_settle.since >= quietMs;
            }""",
            arg=QUIET_MS,
            timeout=QUIET_BUDGET_MS,
            polling=POLL_MS,
        )
    except Exception:  # noqa: BLE001 - a page that never settles is not a failure
        pass
    finally:
        # The observer belongs to the step that started it. Left running, every
        # later step inherits a `since` that some unrelated animation keeps
        # bumping, and none of them ever see the page as still.
        try:
            page.evaluate(
                """() => {
                    const state = window.__autoqa_settle;
                    if (state && state.observer) state.observer.disconnect();
                    delete window.__autoqa_settle;
                }"""
            )
        except Exception:  # noqa: BLE001 - navigated away; it went with the page
            pass
