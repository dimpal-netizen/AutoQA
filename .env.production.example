# Copy to .env.production on the server and fill in. Never commit the filled
# version — .gitignore already covers .env.*
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
POSTGRES_USER=autoqa
POSTGRES_DB=autoqa
# Not "autoqa". The container is not published, but a shared host, a stray
# port-forward or a second container on the same network all reach it.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------
# Security — both required, both must be generated
# ---------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Encrypts stored Jira / Azure DevOps credentials. Losing it means those
# credentials cannot be read back, so keep it with the database backup.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---------------------------------------------------------------
# Addresses
# ---------------------------------------------------------------
# Where a *visitor's browser* reaches the API. Baked into the frontend at
# build time, so changing it needs `up -d --build`, not a restart.
NEXT_PUBLIC_API_URL=https://autoqa.example.com/api/v1

# Who may call the API. Exact string match against the Origin header: scheme,
# host and port all count, and a trailing slash breaks it. In production the
# development localhost regex is off, so anything missing here is refused.
CORS_ORIGINS=https://autoqa.example.com

# ---------------------------------------------------------------
# Recording
# ---------------------------------------------------------------
# Recordings are made in each tester's own Chrome through the AutoQA Recorder
# extension, which the API serves at /api/v1/extension/download - nothing to
# set up here. See docs/deployment.md section 2.
#
# 1 additionally runs Xvfb + noVNC so the API can open a browser on the server
# itself, the way it did before the extension. Leave it at 0: it costs about
# 80 MB and opens an unauthenticated screen-sharing port for nothing.
AUTOQA_VIRTUAL_DISPLAY=0

# ---------------------------------------------------------------
# Execution
# ---------------------------------------------------------------
# Per browser, per run. A recorded flow with a slow checkout can legitimately
# take minutes; the ceiling is what stops a hung one running for ever.
TEST_TIMEOUT_SECONDS=600
RUN_TIMEOUT_SECONDS=900

# Every browser listed is installed in the image and adds roughly 400 MB.
# Trim to chromium alone if that is all a suite is ever run on.
DEFAULT_BROWSERS=chromium,firefox,webkit

# ---------------------------------------------------------------
# AI (optional)
# ---------------------------------------------------------------
# Without a key AutoQA still works — the generated tests get mechanical names
# and no written explanation of a failure.
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
