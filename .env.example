# Copy this file to .env and adjust as needed:
#   Windows PowerShell:  Copy-Item .env.example .env
#   Bash:                cp .env.example .env

# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
APP_NAME=AutoQA
ENVIRONMENT=development          # development | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------
# Database  (matches docker-compose.yml)
# ---------------------------------------------------------------
POSTGRES_USER=autoqa
POSTGRES_PASSWORD=autoqa
POSTGRES_DB=autoqa
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------
# Redis  (Celery broker + WebSocket pub/sub)
# ---------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------------------------------------------------------------
# Security
# ---------------------------------------------------------------
# Generate a real one with:  py -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encrypts Jira / Azure DevOps credentials at rest (Phase 7).
# Generate with:  py -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---------------------------------------------------------------
# AI providers  (Phase 4 — set LLM_PROVIDER once you've decided)
# ---------------------------------------------------------------
LLM_PROVIDER=claude              # claude | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------
# Test execution  (Phase 5)
# ---------------------------------------------------------------
# Both live OUTSIDE backend/ on purpose: `uvicorn --reload` watches that
# folder for .py changes, and a run writes .py files. Under backend/ every
# run restarts the server and kills itself.
STORAGE_PATH=../.autoqa/storage      # screenshots, videos, logs, reports
WORKSPACE_PATH=../.autoqa/workspaces # temp dir per test run
TEST_TIMEOUT_SECONDS=600
DEFAULT_BROWSERS=chromium,firefox,webkit

# ---------------------------------------------------------------
# CORS  (frontend origin — Phase 8)
# ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
